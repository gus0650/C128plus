10 REM BASIC 7.1 SPRITE MOTION TEST: MOVSPR, RSPPOS, RSPRITE, BUMP
20 BANK 15:SCNCLR
30 IF PEEK(53311)<>254 THEN PRINT "VIC-IIX LOCKED. IS BASIC 7.1 INSTALLED?":END
40 PRINT "BASIC 7.1 SPRITE MOTION TEST":PRINT
50 FOR I=0 TO 62:POKE 3584+I,255:NEXT
60 FOR N=1 TO 24:SPRPTR N,56:SPRITE N,1,(N-1 AND 15)+1:NEXT
70 PRINT "1. MOVSPR: THREE ROWS OF 8 SPRITES"
80 FOR K=0 TO 7:FOR R=0 TO 2:MOVSPR K+1+8*R,40+K*30,80+R*50:NEXT R,K:SLEEP 2
90 PRINT "2. RSPPOS(20,..):";RSPPOS(20,0);RSPPOS(20,1);"(SHOULD BE 130 180)"
100 PRINT "3. MOVSPR +1,+0: ROW 3 STEPS RIGHT"
110 FOR S=1 TO 30:FOR N=17 TO 24:MOVSPR N,+1,+0:NEXT N,S
120 PRINT "4. MOVSPR A#S: ROW 2 RIGHT, ROW 3 LEFT"
130 FOR N=9 TO 16:MOVSPR N,90#2:MOVSPR N+8,270#1:NEXT:SLEEP 4
140 PRINT "   SPEED RSPPOS(9,2) =";RSPPOS(9,2);"(SHOULD BE 2)"
150 FOR N=9 TO 24:MOVSPR N,0#0:NEXT
160 PRINT "5. RSPRITE(9,1) =";RSPRITE(9,1);"(SHOULD BE 9)"
170 PRINT "6. BUMP: SPRITE 10 MOVES ONTO SPRITE 11"
180 B=BUMP(3):MOVSPR 10,RSPPOS(11,0),RSPPOS(11,1):SLEEP 1:B=BUMP(3)
190 PRINT "   BUMP(3) =";B;"(SHOULD BE 6)"
200 SLEEP 2:FOR N=1 TO 24:SPRITE N,0:NEXT
210 PRINT:PRINT "DONE."
