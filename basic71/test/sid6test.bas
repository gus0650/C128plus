10 REM C128+ SIX-VOICE SOUND TEST - NEEDS BASIC 7.1 (BOOT2.ROM)
20 SCNCLR:PRINT "C128+ SIX-VOICE SOUND TEST":PRINT
30 SID6 ON:VOL 15:TEMPO 16
40 FOR V=1 TO 6:PLAY "V"+STR$(V)+"T0X0":NEXT
50 PRINT "1. SID 1 (VOICES 1-3): C MAJOR"
60 PLAY "V1O4HCV2O4HEV3O4HG":PLAY "M":SLEEP 1
70 PRINT "2. SID 2 (VOICES 4-6): A MINOR"
80 PLAY "V4O4HAV5O5HCV6O5HE":PLAY "M":SLEEP 1
90 PRINT "3. ALL SIX VOICES: C MAJOR, 5 OCTAVES"
100 PLAY "V1O2WCV2O3WGV3O4WEV4O4WCV5O5WGV6O6WC":PLAY "M":SLEEP 1
110 PRINT "4. VOL A,B: SID 1 ONLY, THEN SID 2 ONLY"
