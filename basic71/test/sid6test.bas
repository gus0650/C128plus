180 PLAY "V1T5X0O3ICEGO4CV4T5X1O3ICEGO4C":PLAY "M":SLEEP 1
190 PLAY "V4X0":PRINT "7. MELODY ON SID 1, BASS ON SID 2"
200 PLAY "V4T0O2HCV1T6O4QCQEV4O2HGV1O4QGQEV4O2HFV1O4QFQAV4O2HGV1O4QGQB"
210 PLAY "V4O2WCV1O5WC":PLAY "M"
220 PRINT:PRINT "DONE. VOICES 4-6 PLAY ON THE SID AT $D420."
