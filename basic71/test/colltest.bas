10 REM BASIC 7.1 COLLISION TEST: BUMP 1-6 AND COLLISION, SPRITES 1-24
20 BANK 15:SCNCLR
30 IF PEEK(53311)<>254 THEN PRINT "VIC-IIX LOCKED. IS BASIC 7.1 INSTALLED?":END
40 PRINT "BASIC 7.1 COLLISION TEST":PRINT
50 FOR I=0 TO 62:POKE 3584+I,255:NEXT
60 FOR N=1 TO 24:SPRPTR N,56:SPRITE N,0,(N-1 AND 15)+1:NEXT
100 PRINT "1. SPRITE-SPRITE, ONE PAIR PER GROUP"
110 FOR G=0 TO 2:A=1+8*G:B=A+1:T=1+2*G
120 X=BUMP(T):MOVSPR A,100,200:MOVSPR B,110,205:SPRITE A,1:SPRITE B,1:SLEEP 1
130 V=BUMP(T):PRINT "  ";A;B;": BUMP(";MID$(STR$(T),2);") =";V;"(SHOULD BE 3)"
140 SPRITE A,0:SPRITE B,0:NEXT
200 PRINT "2. SPRITE-SCREEN, SPRITE OVER TEXT"
210 FOR I=0 TO 9:POKE 1824+I,160:POKE 56096+I,1:NEXT:REM SOLID BLOCK, ROW 20
220 FOR G=0 TO 2:A=1+8*G:T=2+2*G
230 X=BUMP(T):MOVSPR A,40,210:SPRITE A,1:SLEEP 1
240 V=BUMP(T):PRINT "  ";A;": BUMP(";MID$(STR$(T),2);") =";V;"(SHOULD BE 1)"
250 SPRITE A,0:NEXT
300 PRINT "3. COLLISION 1: SPRITE 18 RUNS INTO 17"
310 H=0:X=BUMP(5):COLLISION 1,900
320 MOVSPR 17,200,120:MOVSPR 18,290,120:SPRITE 17,1:SPRITE 18,1
330 MOVSPR 18,270#2:T0=TI
340 DO UNTIL H OR TI-T0>300:LOOP
350 COLLISION 1:MOVSPR 18,0#0
360 IF H THEN PRINT "   GOSUB CALLED, BUMP(5) =";V;"(SHOULD BE 3)":ELSE PRINT "   NO COLLISION (SHOULD NOT HAPPEN)"
370 SLEEP 1:SPRITE 17,0:SPRITE 18,0
380 PRINT:PRINT "DONE."
390 END
900 V=BUMP(5):H=1:RETURN
