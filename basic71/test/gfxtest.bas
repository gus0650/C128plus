10 REM BASIC 7.1 GRAPHICS TEST: SPRITE, SPRPTR, PALETTE, RPALETTE
20 BANK 15:SCNCLR
30 IF PEEK(53311)<>254 THEN PRINT "VIC-IIX LOCKED. IS BASIC 7.1 INSTALLED?":END
40 PRINT "BASIC 7.1 GRAPHICS TEST":PRINT
50 FOR I=0 TO 62:R=INT(I/3)
60 POKE 3584+I,255:POKE 3648+I,170-85*(R AND 1):POKE 3712+I,-255*(R<11):NEXT
70 PRINT "1. SPRITE 1-24 IN THREE ROWS"
80 FOR N=1 TO 24:SPRITE N,1,(N-1 AND 15)+1:NEXT
90 FOR N=1 TO 8:MOVSPR N,40+(N-1)*30,90:NEXT
100 FOR N=0 TO 7:X=40+N*30
110 POKE 53312+2*N,X:POKE 53313+2*N,140:REM SPRITE N+9 ($D040)
120 POKE 53376+2*N,X:POKE 53377+2*N,190:REM SPRITE N+17 ($D080)
130 NEXT:SLEEP 2
140 PRINT "2. SPRPTR: ROW 2 CHECKED, ROW 3 HALF"
150 FOR N=9 TO 16:SPRPTR N,57:SPRPTR N+8,58:NEXT:SLEEP 2
160 PRINT "3. SPRITE 12 EXPANDED, 20 MULTICOLOUR"
170 SPRITE 12,,,,1,1:SPRITE 20,,,,,,1:SLEEP 2
180 SPRITE 12,,,,0,0:SPRITE 20,,,,,,0
190 PRINT "4. PALETTE: COLOUR 2 THROUGH 16 HUES"
200 PALETTE ON
210 FOR H=0 TO 15:PALETTE 1,H,9:FOR D=1 TO 150:NEXT D,H
220 PALETTE 5,9,12:PRINT "5. RPALETTE(5) =";RPALETTE(5);"(SHOULD BE 156)"
230 SLEEP 2:PALETTE RESET:PRINT "6. PALETTE RESET: STOCK COLOURS"
240 SLEEP 2:FOR N=1 TO 24:SPRITE N,0:NEXT
250 PRINT:PRINT "DONE."
